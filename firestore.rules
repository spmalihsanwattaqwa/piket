rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['id', 'date', 'scheduleId', 'teacher', 'subject', 'className', 'day', 'period', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.date is string && data.date.size() <= 20
        && data.scheduleId is string && data.scheduleId.size() <= 128
        && data.teacher is string && data.teacher.size() <= 200
        && data.subject is string && data.subject.size() <= 200
        && data.className is string && data.className.size() <= 50
        && data.day is string && data.day.size() <= 20
        && data.period is number
        && data.status in ['belum', 'hadir', 'tidak_hadir'];
    }

    function isValidLockedEvent(data) {
      return data.keys().hasAll(['id', 'activity', 'date', 'targetClasses'])
        && data.id is string && data.id.size() <= 128
        && data.activity is string && data.activity.size() <= 200
        && data.date is string && data.date.size() <= 20
        && data.targetClasses in ['semua', 'banin', 'banat'];
    }

    function isValidPiketDuty(data) {
      return data.keys().hasAll(['id', 'teacherName', 'startTime', 'endTime', 'day'])
        && data.id is string && data.id.size() <= 128
        && data.teacherName is string && data.teacherName.size() <= 200
        && data.startTime is string && data.startTime.size() <= 20
        && data.endTime is string && data.endTime.size() <= 20
        && data.day is string && data.day.size() <= 20;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /attendance_records/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidAttendance(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    match /locked_events/{eventId} {
      allow read: if true;
      allow create, update: if isValidId(eventId) && isValidLockedEvent(request.resource.data);
      allow delete: if isValidId(eventId);
    }

    match /piket_duties/{dutyId} {
      allow read: if true;
      allow create, update: if isValidId(dutyId) && isValidPiketDuty(request.resource.data);
      allow delete: if isValidId(dutyId);
    }

    match /app_settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId);
      allow delete: if isValidId(settingId);
    }
  }
}
